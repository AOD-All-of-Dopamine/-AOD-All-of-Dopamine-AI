__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# 실제 경로/키가 들어간다 — .env.example 만 커밋한다
.env

# 실 Steam ID/라이브러리 등 개인 데이터
artifacts/user_*

# 표현 실험 아티팩트 — 임베딩(76MB)이 완성된 뒤 선별 커밋한다
artifacts/rep_*/corpus_embeddings.npy
artifacts/rep_*/anchor_embeddings.npy

# 크롤링 원본 (17만 건, 수 GB) — 재수집 가능하므로 커밋하지 않는다
data/steam_games_full.jsonl

# 임베딩 중간 산출물 (raw shard / 텍스트 / 인덱스) — 재시작용이지 결과물이 아니다.
# 실수로 커밋되어 히스토리에 51MB 짜리 부분 shard 가 남았다(ee0542a).
artifacts/*/_embeddings.raw
artifacts/*/_texts.parquet
artifacts/*/_index.parquet
artifacts/*/_targets.sha256

# 전체 코퍼스 임베딩 679MB — 재생성 가능하므로 커밋하지 않는다
artifacts/full_*/corpus_embeddings.npy
artifacts/full_*/anchor_embeddings.npy

# 태그 코퍼스 임베딩(tags_v1 86MB · tags_full 711MB) — dataset/semantic_text 에서 재생성 가능
artifacts/tags_*/corpus_embeddings.npy

# 파괴 사고 격리물(.broken)과 스냅샷 백업 — 로컬 전용 (경위는 src/artifact_ops.py)
artifacts/*.bak-*/
artifacts/*.pre-split/
artifacts/*/*.broken
artifacts/embed_redo.log

# 태그 크롤 원본(110~120MB) — scripts 로 재수집 가능.
#
# **패턴으로 막는다.** 예전에는 파일명을 하나씩 적었는데(`data/steam_tags_v1.jsonl`),
# 태그를 다시 크롤해서 `data/steam_tags.jsonl` 이 생겼을 때 규칙이 없어 그대로 커밋됐다.
# 120MB 라 GitHub 하드 리밋(100MB)을 넘어 브랜치 전체 푸시가 거부됐고, 히스토리에서
# 걷어내야 했다(커밋 f7b518c · fe1be7f · 4eb2511). 크롤 원본은 예외 없이 재수집 가능하므로
# 확장자로 막고, 커밋해야 하는 작은 파생물은 parquet 로 떨어뜨린다.
data/*.jsonl
