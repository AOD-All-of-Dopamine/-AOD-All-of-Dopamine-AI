# 추천 서빙 VM 설정 — scripts/deploy.sh 가 읽는다.
#   cp deploy.env.example deploy.env   (deploy.env 는 커밋하지 않는다 — 주소가 들어간다)
# 비워 두거나 지운 값은 deploy.sh 의 기본값을 쓴다.

# 라우터(8080)를 열 주소. **이 VM 의 사설 IP** 를 넣는다 — 백엔드 API 서버가 이 주소로 부른다.
# 127.0.0.1 이면 VM 안에서만 부를 수 있다. 라우터에는 인증이 없으니 공인 IP 에 열지 말 것.
BIND_IP=127.0.0.1

# 아티팩트 루트 — 그 밑에 {steam,tmdb,webtoon,webnovel}/{코퍼스}/ 가 있어야 한다.
ARTIFACTS_BASE=/srv/aod-artifacts

# prod: 코퍼스가 평가 기준(아래 기본값)과 다르면 config.json 승인 없이는 기동하지 않는다. dev 는 경고만.
SERVING_MODE=prod

# 코퍼스 버전 — 바꾸지 않는 한 평가에 쓴 값이다.
STEAM_CORPUS=tags_full
TMDB_CORPUS=tmdb_v1
WEBTOON_CORPUS=wt_v1
WEBNOVEL_CORPUS=wn_v6

# 이미지 이름. VM 에서 직접 빌드하면 그대로 둔다(태그 기본값 = git 커밋).
REGISTRY=local
# ENGINE_TAG=
# ROUTER_TAG=

# 서빙 가능 목록 — 비우면 전체 코퍼스(README §6-1). 켜면 순위가 바뀔 수 있다.
# STEAM_CATALOG_URL=https://api.allofdophamin.com/api/recommendations/catalog-keys?platform=steam
# TMDB_CATALOG_URL=https://api.allofdophamin.com/api/recommendations/catalog-keys?platform=tmdb
# WEBTOON_CATALOG_URL=https://api.allofdophamin.com/api/recommendations/catalog-keys?platform=webtoon
# WEBNOVEL_CATALOG_URL=https://api.allofdophamin.com/api/recommendations/catalog-keys?platform=webnovel
