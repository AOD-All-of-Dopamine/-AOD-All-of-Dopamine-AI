    "author": {"dtype": "str"}, "artists": {"dtype": "list"}, "episode_count": {"dtype": "int"}, "adult": {"dtype": "bool"},
    "age_type": {"dtype": "str"}, "finished": {"dtype": "bool"}, "rest": {"dtype": "bool"}, "url": {"dtype": "str"},
    "tags": {"dtype": "list", "weights": ["tag_w"]},
    "favorite_count": {"dtype": "int", "weights": ["pop_boost"]},
    "star_score": {"dtype": "float", "weights": ["star_boost"]}
  },
